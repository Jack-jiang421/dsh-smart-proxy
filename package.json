{
  "name": "dsh-smart-proxy",
  "version": "1.2.0",
  "type": "module",
  "description": "Smart network proxy manager for DeepSeek Harness — fixes desktop Transport Failed and TLS interception problems",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "proxy",
    "network",
    "transport-failed",
    "tls"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "baobo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jack-jiang421/dsh-smart-proxy.git"
  },
  "homepage": "https://github.com/Jack-jiang421/dsh-smart-proxy#readme",
  "bugs": {
    "url": "https://github.com/Jack-jiang421/dsh-smart-proxy/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0"
  }
}
